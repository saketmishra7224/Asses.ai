# Primary AI Provider: Groq (ultra-fast inference, https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: Groq model (default: openai/gpt-oss-120b; alternatives: qwen/qwen3.8-27b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# Fallback AI Provider: Google Gemini (https://aistudio.google.com)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

ASSEMBLYAI_API_KEY=
# Optional: GitHub personal access token (raises scraping limit 60 -> 5000 req/hr)
# GITHUB_TOKEN=
# Optional (Docker sets these automatically via docker-compose.yml)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Candidate RAG: Redis Stack vector search (server/RAG) ---
# Index + key namespace for candidate knowledge chunks
RAG_INDEX_NAME=idx:candidate_chunks
RAG_KEY_PREFIX=rag:
# Embedding provider: 'local' (deterministic offline hashing, 0 keys needed) or 'gemini' (Gemini API with GOOGLE_API_KEY).
RAG_EMBEDDING_PROVIDER=local
# Must match the embedding output dimension: 768 default.
RAG_EMBEDDING_DIM=768
# Retrieval defaults
RAG_TOP_K=4
# Planner strategy for technical turns: heuristic (deterministic, default) or llm
RAG_PLANNER_STRATEGY=heuristic
# Answer assessment for adaptive questioning: llm (default, JSON judge) or heuristic
RAG_ASSESS_MODE=llm
# Max technical turns before the interview is guided to wrap up
RAG_MAX_TURNS=20
# Chunking (Phase 2 ingestion)
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150
# Chunk key TTL in seconds (7 days). 0 disables expiry.
RAG_TTL_SECONDS=604800
# HNSW tuning (defaults suit a few hundred chunks per candidate)
# RAG_HNSW_M=16
# RAG_HNSW_EF_CONSTRUCTION=200
# RAG_HNSW_EF_RUNTIME=10
